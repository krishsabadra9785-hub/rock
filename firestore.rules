rules_version = '2';

// ROCK — Cloud Firestore security rules (Spark plan).
//
// The database independently enforces the business's financial integrity:
//
//  * Access: nothing is readable or writable without Firebase Authentication
//    AND an active users/{uid} profile created by an administrator.
//  * Roles: ADMIN, ACCOUNTS, OPERATIONS, VIEW_ONLY (docs/SECURITY.md).
//  * Every order amount is re-derived here from quantity × rate with the same
//    half-up rounding the app uses (integer arithmetic only), so a client
//    cannot save a figure that doesn't follow from the stored rates.
//  * Order paid totals can only move together with exactly one payment being
//    created or voided in the same commit, by exactly that payment's amount,
//    for the obligation matching the payment's category and party.
//    => order.paid[x] == sum of ACTIVE payments linked to the order (by induction).
//  * Paid totals are integer paise, never negative, never above the obligation.
//  * Financial history is never deleted; orders cancel, payments void;
//    cancelled orders can never become confirmed again.
//  * Party default rates can only change together with a new rate-history
//    entry; rate history is append-only and its old/new values must be real.
//  * No receipt images (or other large blobs) can be stored in orders.
//
// Keep src/domain/permissions.ts and src/domain/money.ts (isRoundedProduct)
// in sync with these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // Generic helpers
    // ======================================================================
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function userPath() { return docPath('users', request.auth.uid); }
    function profile() { return get(userPath()).data; }
    function isActive() { return signedIn() && exists(userPath()) && profile().active == true; }
    function hasRole(roles) { return isActive() && profile().role in roles; }
    function isAdmin() { return hasRole(['ADMIN']); }
    function canOperate() { return hasRole(['ADMIN', 'ACCOUNTS', 'OPERATIONS']); }
    function canAccount() { return hasRole(['ADMIN', 'ACCOUNTS']); }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changed() { return incoming().diff(existing()).affectedKeys(); }
    function unchanged(keys) { return !changed().hasAny(keys); }

    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function isOptString(v, max) { return v == null || (v is string && v.size() <= max); }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isISODate(v) { return v is string && v.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }

    // Business limits (mirror src/domain/validation.ts)
    function maxQtyKg() { return 1000000; }        // 1,000 MT
    function maxRate() { return 100000000; }       // ₹10,00,000 per MT
    function maxGstBp() { return 2800; }           // 28%
    function maxPayment() { return 100000000000; } // ₹100 crore

    // amount == roundHalfUp(a × b ÷ div) for non-negative integers, without division:
    //   amount·div − div/2 ≤ a·b < amount·div + div/2
    function roundedProduct(amount, a, b, div, half) {
      return amount is int && amount >= 0
        && amount * div - half <= a * b
        && a * b < amount * div + half;
    }

    // ======================================================================
    // users — access control
    // ======================================================================
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      // The very first admin is created in the Firebase console (bypasses rules).
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['loginId', 'displayName', 'role', 'active', 'updatedAt', 'updatedBy'])
        && incoming().role in ['ADMIN', 'ACCOUNTS', 'OPERATIONS', 'VIEW_ONLY']
        && incoming().active is bool
        && isText(incoming().loginId, 3, 120)
        && isText(incoming().displayName, 1, 120);
      allow update: if (isAdmin()
          && incoming().keys().hasOnly(['loginId', 'displayName', 'role', 'active', 'updatedAt', 'updatedBy'])
          && incoming().role in ['ADMIN', 'ACCOUNTS', 'OPERATIONS', 'VIEW_ONLY']
          && incoming().active is bool
          // an admin cannot remove their own admin access
          && (userId != uid() || (incoming().role == 'ADMIN' && incoming().active == true)))
        || (isActive() && uid() == userId
          && changed().hasOnly(['displayName', 'updatedAt', 'updatedBy'])
          && isText(incoming().displayName, 1, 120));
      allow delete: if false;
    }

    // PIN verifier (salted PBKDF2 hash) — never the PIN. Owner only.
    match /userSecurity/{userId} {
      allow read: if isActive() && uid() == userId;
      allow create, update: if isActive() && uid() == userId
        && incoming().keys().hasOnly(['pinHash', 'pinSalt', 'pinIterations', 'pinUpdatedAt'])
        && isText(incoming().pinHash, 20, 100)
        && isText(incoming().pinSalt, 16, 100)
        && intIn(incoming().pinIterations, 100000, 10000000);
      allow delete: if false;
    }

    // ======================================================================
    // settings
    // ======================================================================
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin() && docId == 'app';
    }

    // ======================================================================
    // parties (buyers, sellers, agents, transporters, payment agents)
    // ======================================================================
    function partyKeys() {
      return ['type', 'code', 'name', 'nameLower', 'phone', 'address', 'gstin', 'notes', 'active',
              'rates', 'defaults', 'demo', 'lastRateChangeId',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }
    function ratesForType(type) {
      return type == 'BUYER' ? ['BUYER_RATE', 'BUYER_GST']
        : type == 'SELLER' ? ['SELLER_RATE']
        : type == 'COMMISSION_AGENT' ? ['COMMISSION_RATE']
        : type == 'TRANSPORTER' ? ['FREIGHT_RATE']
        : ['PAYMENT_AGENT_RATE'];
    }
    function validRates(r, type) {
      return r is map
        && r.keys().hasOnly(ratesForType(type))
        && intIn(r.get('BUYER_RATE', 0), 0, maxRate())
        && intIn(r.get('BUYER_GST', 0), 0, maxGstBp())
        && intIn(r.get('SELLER_RATE', 0), 0, maxRate())
        && intIn(r.get('COMMISSION_RATE', 0), 0, maxRate())
        && intIn(r.get('FREIGHT_RATE', 0), 0, maxRate())
        && intIn(r.get('PAYMENT_AGENT_RATE', 0), 0, maxRate());
    }
    function validPartyBody(d) {
      return d.keys().hasOnly(partyKeys())
        && d.type in ['BUYER', 'SELLER', 'COMMISSION_AGENT', 'TRANSPORTER', 'PAYMENT_AGENT']
        && isText(d.name, 1, 120)
        && isOptString(d.phone, 20) && isOptString(d.address, 300)
        && isOptString(d.gstin, 15) && isOptString(d.notes, 500)
        && d.active is bool
        && validRates(d.rates, d.type);
    }
    // A change of default rates must be accompanied by a NEW rate-history entry
    // for this party in the same commit.
    function rateChangeRecorded(partyId) {
      let hid = incoming().lastRateChangeId;
      return hid is string
        && !exists(docPath('rateHistory', hid))
        && getAfter(docPath('rateHistory', hid)).data.partyId == partyId;
    }

    match /parties/{partyId} {
      allow read: if isActive();
      allow create: if canOperate()
        && validPartyBody(incoming())
        && incoming().code.matches('^(BUY|SEL|AGT|TRN|PAG)-[0-9]{4,}$')
        && incoming().active == true
        && incoming().createdBy == uid() && incoming().updatedBy == uid();
      allow update: if canOperate()
        && validPartyBody(incoming())
        && unchanged(['type', 'code', 'createdAt', 'createdBy'])
        && incoming().updatedBy == uid()
        && (unchanged(['rates']) || rateChangeRecorded(partyId));
      allow delete: if false; // deactivate instead
    }

    // Rate history: append-only; values must be real.
    function validRateHistory(h) {
      let partyPath = docPath('parties', h.partyId);
      let after = getAfter(partyPath).data;
      return h.keys().hasOnly(['partyId', 'partyType', 'rateType', 'oldRate', 'newRate', 'effectiveFrom',
               'changedBy', 'sourceOrderId', 'sourceOrderNumber', 'reason', 'createdAt'])
        && h.changedBy == uid()
        && h.rateType in ratesForType(h.partyType)
        && intIn(h.newRate, 0, maxRate())
        && isISODate(h.effectiveFrom)
        && isOptString(h.reason, 200)
        // the party really has this type and, after this commit, this rate
        && after.type == h.partyType
        && after.rates[h.rateType] == h.newRate
        // oldRate is the party's real previous default (null for a new party / first rate)
        && h.oldRate == (exists(partyPath) ? get(partyPath).data.rates.get(h.rateType, null) : null)
        && h.oldRate != h.newRate;
    }
    match /rateHistory/{entryId} {
      allow read: if isActive();
      allow create: if canOperate() && validRateHistory(incoming());
      allow update, delete: if false;
    }

    // ======================================================================
    // counters (order numbers, party codes): strictly +1
    // ======================================================================
    match /counters/{counterId} {
      allow read: if isActive();
      allow create: if canOperate()
        && counterId.matches('^(orders-20[0-9]{2}|party-[A-Z_]+)$')
        && incoming().seq == 1;
      allow update: if canOperate() && incoming().seq == existing().seq + 1;
      allow delete: if false;
    }

    // ======================================================================
    // orders
    // ======================================================================
    function orderKeys() {
      return ['orderNumber', 'seq', 'counterId', 'status', 'dispatchDate', 'qtyKg', 'receipt',
              'buyer', 'seller', 'commission', 'freight', 'paymentAgent',
              'buyerId', 'sellerId', 'commissionAgentId', 'transporterId', 'paymentAgentId',
              'paid', 'lastPaymentId', 'rateDecisions', 'searchTokens', 'notes', 'version',
              'cancelReason', 'demo', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    // Receipt holds confirmed text only. No image content can fit or be smuggled.
    function validReceipt(r, d) {
      return r.keys().hasOnly(['image', 'receiptNumber', 'driverName', 'driverPhone', 'vehicleNumber',
               'destination', 'dispatchDate', 'netQtyKg', 'ai', 'confirmedAt', 'confirmedBy'])
        && r.image.keys().hasOnly(['provider', 'ref', 'fileName', 'contentType', 'sizeBytes'])
        && r.image.provider in ['NONE', 'FIREBASE_STORAGE']
        && (r.image.provider != 'NONE' || r.image.ref == null)
        && isOptString(r.image.ref, 300) && isOptString(r.image.fileName, 120)
        && isOptString(r.image.contentType, 60)
        && (r.image.sizeBytes == null || r.image.sizeBytes is int)
        && isOptString(r.receiptNumber, 120) && isOptString(r.driverName, 120)
        && isOptString(r.driverPhone, 20) && isOptString(r.vehicleNumber, 20)
        && isOptString(r.destination, 120)
        && r.ai.keys().hasOnly(['status', 'model', 'raw', 'error'])
        && r.ai.status in ['SUCCESS', 'PARTIAL', 'FAILED', 'SKIPPED']
        && isOptString(r.ai.model, 80) && isOptString(r.ai.raw, 8000) && isOptString(r.ai.error, 500)
        && r.netQtyKg == d.qtyKg
        && r.dispatchDate == d.dispatchDate;
    }

    // Paid totals: integer paise, 0 ≤ paid ≤ obligation (no overpayment against an order).
    function paidWithin(v, obligation) { return v is int && v >= 0 && (v == 0 || v <= obligation); }
    function validPaid(d) {
      return d.paid.keys().hasOnly(['buyer', 'seller', 'commission', 'freight', 'paymentAgent'])
        && d.paid.keys().hasAll(['buyer', 'seller', 'commission', 'freight', 'paymentAgent'])
        && paidWithin(d.paid.buyer, d.buyer.grossAmount)
        && paidWithin(d.paid.seller, d.seller.amount)
        && paidWithin(d.paid.commission, d.commission.amount)
        && paidWithin(d.paid.freight, d.freight.amount)
        && paidWithin(d.paid.paymentAgent, d.paymentAgent.balance);
    }
    function allPaidZero(d) {
      return d.paid.buyer == 0 && d.paid.seller == 0 && d.paid.commission == 0
        && d.paid.freight == 0 && d.paid.paymentAgent == 0;
    }

    // Every amount re-derived from quantity × rate (same rounding as the app).
    function validFinancials(d) {
      return intIn(d.qtyKg, 1, maxQtyKg())
        && isISODate(d.dispatchDate)
        && intIn(d.buyer.ratePaise, 0, maxRate())
        && intIn(d.buyer.gstBp, 0, maxGstBp())
        && roundedProduct(d.buyer.baseAmount, d.qtyKg, d.buyer.ratePaise, 1000, 500)
        && roundedProduct(d.buyer.gstAmount, d.buyer.baseAmount, d.buyer.gstBp, 10000, 5000)
        && d.buyer.grossAmount == d.buyer.baseAmount + d.buyer.gstAmount
        && intIn(d.seller.ratePaise, 0, maxRate())
        && roundedProduct(d.seller.amount, d.qtyKg, d.seller.ratePaise, 1000, 500)
        && intIn(d.commission.ratePaise, 0, maxRate())
        && roundedProduct(d.commission.amount, d.qtyKg, d.commission.ratePaise, 1000, 500)
        && intIn(d.freight.ratePaise, 0, maxRate())
        && roundedProduct(d.freight.amount, d.qtyKg, d.freight.ratePaise, 1000, 500)
        && intIn(d.paymentAgent.ratePaise, 0, maxRate())
        && roundedProduct(d.paymentAgent.deduction, d.qtyKg, d.paymentAgent.ratePaise, 1000, 500)
        // Payment agent receives the buyer gross and passes on gross − deduction
        && d.paymentAgent.received == d.buyer.grossAmount
        && d.paymentAgent.balance == d.paymentAgent.received - d.paymentAgent.deduction
        // No party → no rate and no amount
        && (d.commissionAgentId != null || (d.commission.ratePaise == 0 && d.commission.amount == 0))
        && (d.transporterId != null || (d.freight.ratePaise == 0 && d.freight.amount == 0))
        && (d.paymentAgentId != null || (d.paymentAgent.ratePaise == 0 && d.paymentAgent.deduction == 0))
        && validPaid(d)
        && d.searchTokens is list && d.searchTokens.size() <= 120
        && isOptString(d.notes, 500);
    }

    // Order lines must point at real parties of the right type (create only;
    // parties can never change afterwards).
    function partyOk(id, line, type) {
      let p = get(docPath('parties', id)).data;
      return id is string && line.id == id && p.type == type && line.name == p.name;
    }
    function optionalPartyOk(id, line, type) {
      return (id == null && line.id == null) || partyOk(id, line, type);
    }
    function validParties(d) {
      return partyOk(d.buyerId, d.buyer, 'BUYER')
        && partyOk(d.sellerId, d.seller, 'SELLER')
        && optionalPartyOk(d.commissionAgentId, d.commission, 'COMMISSION_AGENT')
        && optionalPartyOk(d.transporterId, d.freight, 'TRANSPORTER')
        && optionalPartyOk(d.paymentAgentId, d.paymentAgent, 'PAYMENT_AGENT');
    }

    // Order number = the counter value allocated in this very commit.
    function validNumbering(d) {
      let c = docPath('counters', d.counterId);
      return d.counterId is string && d.counterId.matches('^orders-20[0-9]{2}$')
        && d.seq is int && d.seq >= 1
        && getAfter(c).data.seq == d.seq
        && ((d.seq == 1 && !exists(c)) || (exists(c) && get(c).data.seq == d.seq - 1))
        && d.orderNumber.matches('^[A-Z0-9]{1,10}-' + d.counterId.split('-')[1] + '-0*' + string(d.seq) + '$');
    }

    // Payment category → order obligation / party field
    function paidKeyFor(category) {
      return category == 'BUYER_RECEIPT' ? 'buyer'
        : category == 'SELLER_PAYMENT' ? 'seller'
        : category == 'COMMISSION_PAYMENT' ? 'commission'
        : category == 'TRANSPORTER_PAYMENT' ? 'freight'
        : category == 'PAYMENT_AGENT_SETTLEMENT' ? 'paymentAgent'
        : 'none';
    }
    function partyTypeFor(category) {
      return category == 'BUYER_RECEIPT' ? 'BUYER'
        : category == 'SELLER_PAYMENT' ? 'SELLER'
        : category == 'COMMISSION_PAYMENT' ? 'COMMISSION_AGENT'
        : category == 'TRANSPORTER_PAYMENT' ? 'TRANSPORTER'
        : category == 'PAYMENT_AGENT_SETTLEMENT' ? 'PAYMENT_AGENT'
        : 'none';
    }
    function orderPartyFor(o, key) {
      return key == 'buyer' ? o.buyerId
        : key == 'seller' ? o.sellerId
        : key == 'commission' ? o.commissionAgentId
        : key == 'freight' ? o.transporterId
        : key == 'paymentAgent' ? o.paymentAgentId
        : null;
    }

    // Only paid[key] changes, by exactly `delta`.
    function paidMovedBy(key, delta) {
      return key != 'none'
        && incoming().paid.diff(existing().paid).affectedKeys().hasOnly([key])
        && incoming().paid[key] == existing().paid[key] + delta;
    }
    // The paid change is backed by the payment named in lastPaymentId being
    // created (ACTIVE) or voided in this same commit, for this order.
    function paidChangeBackedByPayment(orderId) {
      let pid = incoming().lastPaymentId;
      let paymentPath = docPath('payments', pid);
      let after = getAfter(paymentPath).data;
      let isNew = !exists(paymentPath);
      return pid is string && after.orderId == orderId && (
        // payment created in this commit: paid moves up by its amount
        (isNew && after.status == 'ACTIVE' && paidMovedBy(paidKeyFor(after.category), after.amount))
        ||
        // payment voided in this commit: paid moves down by its amount
        (!isNew && get(paymentPath).data.status == 'ACTIVE' && after.status == 'VOID'
          && paidMovedBy(paidKeyFor(after.category), 0 - after.amount))
      );
    }

    match /orders/{orderId} {
      allow read: if isActive();

      allow create: if canOperate()
        && incoming().keys().hasOnly(orderKeys())
        && incoming().status == 'CONFIRMED'
        && incoming().version == 1
        && incoming().cancelReason == null
        && incoming().lastPaymentId == null
        && incoming().createdBy == uid() && incoming().updatedBy == uid()
        && incoming().rateDecisions is list && incoming().rateDecisions.size() <= 6
        && allPaidZero(incoming())
        && validReceipt(incoming().receipt, incoming())
        && validFinancials(incoming())
        && validParties(incoming())
        && validNumbering(incoming());

      allow update: if canAccount()
        && incoming().keys().hasOnly(orderKeys())
        && unchanged(['orderNumber', 'seq', 'counterId', 'createdAt', 'createdBy',
             'buyerId', 'sellerId', 'commissionAgentId', 'transporterId', 'paymentAgentId', 'rateDecisions'])
        && incoming().updatedBy == uid()
        && existing().status == 'CONFIRMED'   // cancelled orders are final
        && (
          // (a) a payment was recorded or voided: only paid totals move, backed by that payment
          (incoming().status == 'CONFIRMED'
            && changed().hasOnly(['paid', 'lastPaymentId', 'updatedAt', 'updatedBy'])
            && validPaid(incoming())
            && paidChangeBackedByPayment(orderId))
          ||
          // (b) audited correction: figures re-validated, paid untouched and still within obligations
          (incoming().status == 'CONFIRMED'
            && unchanged(['paid', 'lastPaymentId', 'cancelReason'])
            && incoming().version == existing().version + 1
            && validReceipt(incoming().receipt, incoming())
            && validFinancials(incoming()))
          ||
          // (c) cancellation by an administrator, only when nothing has been paid
          (isAdmin()
            && incoming().status == 'CANCELLED'
            && allPaidZero(existing())
            && changed().hasOnly(['status', 'cancelReason', 'version', 'updatedAt', 'updatedBy'])
            && incoming().version == existing().version + 1
            && isText(incoming().cancelReason, 3, 300))
        );

      allow delete: if false;
    }

    // ======================================================================
    // payments
    // ======================================================================
    function paymentKeys() {
      return ['category', 'date', 'amount', 'partyId', 'partyType', 'partyName', 'orderId', 'orderNumber',
              'method', 'reference', 'notes', 'status', 'voidReason', 'demo',
              'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }
    // Party must exist with the declared type, and the type must match the category.
    function validPaymentParty(p) {
      return (p.partyId == null && p.partyType == null && p.category == 'OTHER')
        || (p.partyId is string
            && get(docPath('parties', p.partyId)).data.type == p.partyType
            && (p.category == 'OTHER' || partyTypeFor(p.category) == p.partyType));
    }
    // A payment linked to an order must be for that order's party in that role,
    // and the order's paid total must move by exactly this amount in this commit.
    function validPaymentOrderOnCreate(paymentId, p) {
      return (p.orderId == null && p.orderNumber == null)
        || (p.orderId is string && p.category != 'OTHER' && orderAcceptsPayment(paymentId, p));
    }
    function orderAcceptsPayment(paymentId, p) {
      let before = get(docPath('orders', p.orderId)).data;
      let after = getAfter(docPath('orders', p.orderId)).data;
      let key = paidKeyFor(p.category);
      return before.status == 'CONFIRMED'
        && before.orderNumber == p.orderNumber
        && orderPartyFor(before, key) == p.partyId
        && after.lastPaymentId == paymentId
        && after.paid[key] == before.paid[key] + p.amount;
    }
    function validPaymentOrderOnVoid(paymentId, p) {
      return p.orderId == null || orderAcceptsVoid(paymentId, p);
    }
    function orderAcceptsVoid(paymentId, p) {
      let before = get(docPath('orders', p.orderId)).data;
      let after = getAfter(docPath('orders', p.orderId)).data;
      let key = paidKeyFor(p.category);
      return after.lastPaymentId == paymentId
        && after.paid[key] == before.paid[key] - p.amount;
    }

    match /payments/{paymentId} {
      allow read: if isActive();
      allow create: if canAccount()
        && incoming().keys().hasOnly(paymentKeys())
        && incoming().createdBy == uid() && incoming().updatedBy == uid()
        && incoming().status == 'ACTIVE' && incoming().voidReason == null
        && intIn(incoming().amount, 1, maxPayment())
        && isISODate(incoming().date)
        && incoming().category in ['BUYER_RECEIPT', 'SELLER_PAYMENT', 'COMMISSION_PAYMENT',
             'TRANSPORTER_PAYMENT', 'PAYMENT_AGENT_SETTLEMENT', 'OTHER']
        && incoming().method in ['BANK', 'UPI', 'CASH', 'CHEQUE', 'OTHER']
        && isOptString(incoming().notes, 500) && isOptString(incoming().reference, 80)
        && isOptString(incoming().partyName, 120)
        && validPaymentParty(incoming())
        && validPaymentOrderOnCreate(paymentId, incoming());
      // Void only. Amount, party, order, category, date can never change.
      allow update: if canAccount()
        && existing().status == 'ACTIVE' && incoming().status == 'VOID'
        && changed().hasOnly(['status', 'voidReason', 'updatedAt', 'updatedBy'])
        && incoming().updatedBy == uid()
        && isText(incoming().voidReason, 3, 300)
        && validPaymentOrderOnVoid(paymentId, existing());
      allow delete: if false;
    }

    // ======================================================================
    // rollups — derived dashboard statistics (rebuildable from orders + payments)
    // ======================================================================
    function totalsPaid(d) { return d.get(['totals', 'paid'], {}); }
    match /rollups/{key} {
      allow read: if isActive();
      allow create, update: if canOperate()
        && key.matches('^(D-20[0-9]{2}-[01][0-9]-[0-3][0-9]|M-20[0-9]{2}-[01][0-9])$')
        && incoming().kind in ['D', 'M']
        && incoming().keys().hasOnly(['kind', 'key', 'totals', 'parties', 'updatedAt'])
        // payment totals can only be changed by roles that can record payments
        && (canAccount() || totalsPaid(incoming()) == (resource == null ? {} : totalsPaid(existing())));
      allow delete: if isAdmin(); // "Rebuild statistics"
    }

    // ======================================================================
    // audit log — append-only
    // ======================================================================
    match /auditLogs/{entryId} {
      allow read: if canAccount();
      allow create: if canOperate()
        && incoming().keys().hasOnly(['entityType', 'entityId', 'action', 'summary', 'changes', 'reason', 'actorId', 'at'])
        && incoming().actorId == uid()
        && incoming().entityType in ['order', 'payment', 'party', 'settings', 'user', 'system']
        && isText(incoming().summary, 1, 500)
        && isOptString(incoming().reason, 300);
      allow update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
