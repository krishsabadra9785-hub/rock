# ---------------------------------------------------------------------------
# ROCK environment configuration
#
# LOCAL: copy this file to `.env.local` and fill in the values.
# GITHUB PAGES: add the same names as repository *Variables* in
#   GitHub → repo → Settings → Secrets and variables → Actions → Variables.
#
# Values come from: Firebase console → Project settings (gear) → General →
#   Your apps → Web app → "SDK setup and configuration" → Config.
#
# These Firebase WEB config values identify your project; they are NOT
# passwords and are visible in every website that uses Firebase. Your data is
# protected by Firebase Authentication + firestore.rules + App Check.
# `.env.local` is git-ignored anyway. NEVER put service-account JSON,
# private keys, passwords or PINs in any file.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rock-e6719.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rock-e6719
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional (only present if Analytics was enabled; ROCK doesn't use Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# Login IDs are turned into Firebase emails as <loginid>@<this domain>.
# Example: login ID "owner" → owner@rock.local (create that user in Firebase Auth).
VITE_LOGIN_EMAIL_DOMAIN=rock.local

# App Check (reCAPTCHA v3 — free, no billing). The SITE key is public.
# Leave empty only while first testing locally.
VITE_RECAPTCHA_V3_SITE_KEY=

# AI model for receipt reading via Firebase AI Logic (Gemini Developer API free tier).
# Can also be changed later in ROCK → Settings → AI.
VITE_AI_MODEL=gemini-2.5-flash

# Local development only:
VITE_USE_EMULATORS=false
# true = show "Load demo data" in Settings → Data. Keep false in production.
VITE_ENABLE_DEMO_TOOLS=false
